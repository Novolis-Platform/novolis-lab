<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\novolis-governance\build\Novolis.Version.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)..\novolis-governance\build\Novolis.Version.targets')" />
  <Import Project="$(MSBuildThisFileDirectory)..\novolis-governance\build\Novolis.Packaging.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)..\novolis-governance\build\Novolis.Packaging.targets')" />

  <PropertyGroup>
    <_NovolisLabProjectText Condition="Exists('$(MSBuildProjectFullPath)')">$([System.IO.File]::ReadAllText('$(MSBuildProjectFullPath)'))</_NovolisLabProjectText>
  </PropertyGroup>

  <ItemGroup Condition="$(_NovolisLabProjectText.Contains('Include=&quot;Avalonia'))">
    <Compile Include="$(MSBuildThisFileDirectory)labs\shared\Novolis.Lab.Branding\NovolisLabBranding.cs"
             Link="NovolisLabBranding.cs"
             Visible="false" />
  </ItemGroup>

  <!-- Android consumers need Native buildTransitive (AndroidNativeLibrary). Desktop keeps ExcludeAssets from Directory.Build.props. -->
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android'))">
    <PackageReference Update="Novolis.Raylib">
      <ExcludeAssets></ExcludeAssets>
    </PackageReference>
    <PackageReference Update="Novolis.Raylib.Native">
      <ExcludeAssets></ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
