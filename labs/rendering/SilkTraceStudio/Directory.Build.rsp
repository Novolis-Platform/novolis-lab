# Faster local Studio restores: skip NuGet audit + SourceLink GitHub queries on the whole ProjectRef graph.
/p:NuGetAudit=false
/p:EnableSourceLink=false
/p:EnableSourceControlManagerQueries=false
/p:NovolisUseProjectReferences=true
# Avoid accumulating dozens of MSBuild node-reuse workers that starve NuGet (see build-server shutdown).
/p:DisableNodeReuse=true
