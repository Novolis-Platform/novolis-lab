<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NovolisGraphicalProfile>true</NovolisGraphicalProfile>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CoverageStudio</RootNamespace>
    <AssemblyName>CoverageStudio</AssemblyName>
    <ApplicationTitle>Coverage Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Explore org-wide test coverage, cyclomatic complexity / CRAP hotspots, and run tests across novolis-* repos.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <LibraryReference Include="Novolis.Avalonia.Controls" />
    <LibraryReference Include="Novolis.Avalonia.Layout" />
    <LibraryReference Include="Novolis.Avalonia.Studio" />
    <LibraryReference Include="Novolis.Tools.Coverage" />
  </ItemGroup>
</Project>
