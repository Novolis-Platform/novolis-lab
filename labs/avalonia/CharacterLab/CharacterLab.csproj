<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>CharacterLab</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Avalonia dogfood — CMU BVH mocap player, wire mannequin, hold-point rifle IK.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
    <LibraryReference Include="Novolis.Avalonia.ThreeD" />
    <LibraryReference Include="Novolis.Game.Humanoid" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.ThreeD.Scene" />
    <LibraryReference Include="Novolis.Simulation.Humanoid" />
    <LibraryReference Include="Novolis.Simulation.Humanoid.Import" />
    <PackageReference Include="Silk.NET.OpenGL" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="assets" />
  </ItemGroup>
  <!-- Mesh FBX path deferred until wire mocap + holds are trusted. -->
  <ItemGroup>
    <Compile Remove="Demo\DrillParadeDriver.cs" />
  </ItemGroup>
</Project>
