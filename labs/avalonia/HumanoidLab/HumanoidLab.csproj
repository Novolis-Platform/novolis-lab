    <PackageReference Include="Novolis.Game.Humanoid" />
    <PackageReference Include="Novolis.Math.Arrays" />
    <PackageReference Include="Novolis.Math.Geometry" />
    <PackageReference Include="Novolis.Physics.Collision.Simple" />
    <PackageReference Include="Novolis.Physics.Joints" />
    <PackageReference Include="Novolis.Simulation.Humanoid" />
    <PackageReference Include="Novolis.Simulation.Humanoid.Physics" />
    <PackageReference Include="Novolis.Simulation.Humanoid.Skinning" />
    <PackageReference Include="Novolis.Simulation.World" />
    <PackageReference Include="Novolis.Simulation.World.Builders" />
  </ItemGroup>
</Project>
