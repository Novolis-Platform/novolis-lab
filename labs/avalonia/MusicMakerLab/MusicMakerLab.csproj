<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MusicMakerLab</RootNamespace>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Music Maker / Audacity–style arrangement + MIDI piano dogfood for Novolis.Audio.Edit / Midi + Novolis.Avalonia.Audio.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="MeltySynth" />
    <LibraryReference Include="Novolis.Avalonia.Audio" />
    <LibraryReference Include="Novolis.Audio.Catalog" />
    <LibraryReference Include="Novolis.Audio.Edit" />
    <LibraryReference Include="Novolis.Audio.Midi" />
    <LibraryReference Include="Novolis.Audio.Core" />
  </ItemGroup>
</Project>
