<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ViewportBench</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Dogfood all CAD wireframe presenters with one shared scene, shared orbit camera, and present-time benchmarks.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Novolis.Avalonia.ThreeD" />
    <PackageReference Include="Novolis.Agent.Surface" />
    <PackageReference Include="Novolis.ThreeD.Scene" />
    <PackageReference Include="Novolis.Avalonia.Raylib" />
    <PackageReference Include="Novolis.Raylib" />
    <PackageReference Include="Novolis.Raylib.Abstractions" />
    <PackageReference Include="Novolis.Raylib.Bindings" />
    <PackageReference Include="Novolis.Raylib.Runtime" />
    <PackageReference Include="Novolis.Avalonia.Rendering" />
    <PackageReference Include="Novolis.Rendering.Backends.Vulkan" />
    <!-- ProjectRef non-transitive: Silk natives for OpenGL / Vulkan wire presenters. -->
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Shaderc" />
    <PackageReference Include="Silk.NET.Shaderc.Native" />
  </ItemGroup>
</Project>
