<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MobilityLab</RootNamespace>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>
      Controlled tax–mobility Avalonia lab: twin treatment/control on Civics/Economy/Geopolitics
      with series, map, and PASS/FAIL coupling scorecard.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.Avalonia.Briefing" />
    <LibraryReference Include="Novolis.Civics.Agents" />
    <LibraryReference Include="Novolis.Civics.Core" />
    <LibraryReference Include="Novolis.Civics.EconomyBridge" />
    <LibraryReference Include="Novolis.Economy.Core" />
    <LibraryReference Include="Novolis.Economy.Simulation" />
    <LibraryReference Include="Novolis.Geopolitics.Conflict" />
    <LibraryReference Include="Novolis.Geopolitics.Core" />
    <LibraryReference Include="Novolis.Geopolitics.Diplomacy" />
    <LibraryReference Include="Novolis.Geopolitics.Trade" />
  </ItemGroup>
</Project>
