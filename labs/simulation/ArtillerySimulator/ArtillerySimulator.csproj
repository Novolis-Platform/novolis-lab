<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArtillerySimulator</RootNamespace>
    <AssemblyTitle>K9 DOG</AssemblyTitle>
    <Product>K9 DOG — Howitzer defence simulation game</Product>
    <Description>Educational artillery sandbox. Fiction. Not affiliated with any manufacturer or armed force.</Description>
    <ApplicationIcon>assets\k9-dog-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime map assets only — pipeline TIFFs / diagnose / POC stay in the source tree. -->
    <None Include="map\layers\heightfield-1025.bin" CopyToOutputDirectory="PreserveNewest" Link="map\layers\heightfield-1025.bin" />
    <None Include="map\layers\nvdb-roads.bin" CopyToOutputDirectory="PreserveNewest" Link="map\layers\nvdb-roads.bin" />
    <None Include="map\layers\water-mask.png" CopyToOutputDirectory="PreserveNewest" Link="map\layers\water-mask.png" />
    <None Include="map\layers\water-mask.bin" CopyToOutputDirectory="PreserveNewest" Link="map\layers\water-mask.bin" />
    <None Include="map\kristiansand-land-sea-mask.bin" CopyToOutputDirectory="PreserveNewest" Link="map\kristiansand-land-sea-mask.bin" />
    <None Include="map\oslofjorden\layers\heightfield-1025.bin" CopyToOutputDirectory="PreserveNewest" Link="map\oslofjorden\layers\heightfield-1025.bin" />
    <None Include="map\oslofjorden\oslofjorden-land-sea-mask.bin" CopyToOutputDirectory="PreserveNewest" Link="map\oslofjorden\oslofjorden-land-sea-mask.bin" />
    <None Include="map\kommunekart-3d-view.json" CopyToOutputDirectory="PreserveNewest" Link="map\kommunekart-3d-view.json" />
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="assets" />
    <!-- File-based map pipeline apps; not part of the game compile. -->
    <Compile Remove="scripts\**\*" />
    <None Include="scripts\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="SkiaSharp" />
    <LibraryReference Include="Novolis.Messaging.Channels" />
    <LibraryReference Include="Novolis.Silk" />
    <LibraryReference Include="Novolis.Game.MenuFlows" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.Physics.Ballistics" />
    <LibraryReference Include="Novolis.Physics.Collision.Simple" />
    <LibraryReference Include="Novolis.Simulation.World" />
    <LibraryReference Include="Novolis.Simulation.World.Builders" />
    <LibraryReference Include="Novolis.Simulation.View" />
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
    <LibraryReference Include="Novolis.Audio" />
    <LibraryReference Include="Novolis.Audio.Abstractions" />
    <LibraryReference Include="Novolis.Audio.Runtime" />
    <LibraryReference Include="Novolis.Audio.Core" />
    <LibraryReference Include="Novolis.Audio.Midi" />
    <LibraryReference Include="Novolis.Audio.Voice" />
    <LibraryReference Include="Novolis.Audio.Voice.Abstractions" />
    <LibraryReference Include="Novolis.Audio.Voice.Profiles" />
    <LibraryReference Include="Novolis.Audio.Voice.SherpaOnnx" />
    <LibraryReference Include="Novolis.Audio.Effects" />
    <LibraryReference Include="Novolis.Audio.Filters" />
    <ProjectReference Include="..\..\shared\Novolis.Lab.Voice\Novolis.Lab.Voice.csproj" />
  </ItemGroup>
</Project>
