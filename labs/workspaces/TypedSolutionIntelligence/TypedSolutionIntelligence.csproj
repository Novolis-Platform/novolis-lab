<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TypedSolutionIntelligence</RootNamespace>
    <Description>Walks Novolis.Workspaces.DotNet: solution workspace, Git relation, SLNX, MSBuild, Roslyn, and catalog queries.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);fixture\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="fixture\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixture\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="Novolis.IO.Git" />
    <PackageReference Include="Novolis.IO.Workspace.Abstractions" />
    <PackageReference Include="Novolis.Workspaces.DotNet.Abstractions" />
    <PackageReference Include="Novolis.Workspaces.DotNet.Git" />
    <PackageReference Include="Novolis.Workspaces.DotNet.Slnx" />
    <PackageReference Include="Novolis.Workspaces.DotNet.MSBuild" />
    <PackageReference Include="Novolis.Workspaces.DotNet.Roslyn" />
    <PackageReference Include="Novolis.Workspaces.DotNet.Indexing" />
  </ItemGroup>
</Project>
