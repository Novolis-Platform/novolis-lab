<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CalypsoInternalsCad</RootNamespace>
    <ApplicationTitle>Calypso Internals CAD</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Lock → CAD SoT lives in CalypsoCad; this app owns CAD + 3D export / view for the internals pack. -->
  <ItemGroup>
    <Compile Include="..\CalypsoCad\Generation\CalypsoLockGenerator.cs" Link="Generation\CalypsoLockGenerator.cs" />
    <Compile Include="..\CalypsoCad\Models\CadAppearanceExtension.cs">
      <Link>Models\CadAppearanceExtension.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadCatalogLayer.cs">
      <Link>Models\CadCatalogLayer.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadFill.cs">
      <Link>Models\CadFill.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadLayersDocument.cs">
      <Link>Models\CadLayersDocument.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadMaterialExtension.cs">
      <Link>Models\CadMaterialExtension.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadModels.cs" Link="Models\CadModels.cs" />
    <Compile Include="..\CalypsoCad\Models\CadShape.cs">
      <Link>Models\CadShape.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadShapeExtensions.cs">
      <Link>Models\CadShapeExtensions.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadShapesDocument.cs">
      <Link>Models\CadShapesDocument.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Models\CadStroke.cs">
      <Link>Models\CadStroke.cs</Link>
    </Compile>
    <Compile Include="..\CalypsoCad\Services\CadDocumentStore.cs" Link="Services\CadDocumentStore.cs" />
    <Compile Include="..\CalypsoCad\Services\SvgCoords.cs">
      <Link>Services\SvgCoords.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <LibraryReference Include="Novolis.Avalonia.Cad.Ship" />
    <LibraryReference Include="Novolis.Cad.Primitives" />
    <LibraryReference Include="Novolis.Cad.SceneBridge" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <PackageReference Include="Novolis.Raylib" />
    <LibraryReference Include="Novolis.Raylib.Bindings" />
    <LibraryReference Include="Novolis.Raylib.Runtime" />
    <LibraryReference Include="Novolis.Ship.Primitives" />
    <LibraryReference Include="Novolis.Ship.Structure" />
    <LibraryReference Include="Novolis.Ship.Topology" />
    <LibraryReference Include="Novolis.Ship.Validation" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CalypsoCad\docs\internals\CAL-INT-GA-001.json" Link="lock\CAL-INT-GA-001.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CalypsoCad\docs\manufacturer\CAL-HULL-CAD-001.json" Link="lock\CAL-HULL-CAD-001.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
