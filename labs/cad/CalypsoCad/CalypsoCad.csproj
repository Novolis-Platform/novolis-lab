<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CalypsoCad</RootNamespace>
    <ApplicationTitle>Calypso CAD</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NovolisGraphicalProfile>false</NovolisGraphicalProfile>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
    <LibraryReference Include="Novolis.Cad.Primitives" />
    <LibraryReference Include="Novolis.Cad.SceneBridge" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.Math.Topology" />
    <LibraryReference Include="Novolis.Ship.Primitives" />
    <LibraryReference Include="Novolis.Ship.Topology" />
    <LibraryReference Include="Novolis.Ship.Validation" />
    <LibraryReference Include="Novolis.Ship.Structure" />
    <LibraryReference Include="Novolis.Silk" />
    <LibraryReference Include="Novolis.Simulation.View" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="docs\internals\CAL-INT-GA-001.json" Link="lock\CAL-INT-GA-001.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="docs\manufacturer\CAL-HULL-CAD-001.json" Link="lock\CAL-HULL-CAD-001.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*" />
    <None Include="tools\**\*" />
  </ItemGroup>
</Project>
