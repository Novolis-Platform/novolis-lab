<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FrankMoat</RootNamespace>
    <Description>Single-room Loaded-style top-down shooter — Level 69 minigun range prototype.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**\*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FrankMoat.Unit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Game.MenuFlows" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <!-- Explicit: ProjectRef mode is non-transitive for NuGet graphs. -->
    <LibraryReference Include="Novolis.Math.Topology" />
    <LibraryReference Include="Novolis.Rendering.TwoD" />
    <LibraryReference Include="Novolis.Silk" />
    <LibraryReference Include="Novolis.Rendering.Presentation.Abstractions" />
    </ItemGroup>
</Project>
