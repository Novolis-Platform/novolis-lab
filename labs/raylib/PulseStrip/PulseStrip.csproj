<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PulseStrip</RootNamespace>
    <Description>3D anti-grav racer homage — spline circuits, weapons, procedural FX/SFX, ML opponents (Win/Linux).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssimpNet" />
    <LibraryReference Include="Novolis.Audio" />
    <LibraryReference Include="Novolis.Audio.Abstractions" />
    <LibraryReference Include="Novolis.Audio.Runtime" />
    <LibraryReference Include="Novolis.Game.MenuFlows" />
    <LibraryReference Include="Novolis.MachineLearning.Neural" />
    <LibraryReference Include="Novolis.MachineLearning.Neural.Abstractions" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.ThreeD.Import.Assimp" />
    <LibraryReference Include="Novolis.Simulation.Racing" />
    <PackageReference Include="Novolis.Raylib">
      <ExcludeAssets>buildTransitive</ExcludeAssets>
    </PackageReference>
    <LibraryReference Include="Novolis.Raylib.Game" />
    <LibraryReference Include="Novolis.Raylib.Bindings" />
    <LibraryReference Include="Novolis.Raylib.Runtime" />
    <ProjectReference Include="..\PulseStrip.Core\PulseStrip.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
